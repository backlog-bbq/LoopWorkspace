# loop-build settings. Copy to ~/.config/loop-build/config and run:
#   chmod 600 ~/.config/loop-build/config
# loop-build refuses to run if other users can read this file or the API key.

# Your 10-character Apple Developer Team ID (developer.apple.com > Membership).
TEAMID="XXXXXXXXXX"

# App Store Connect API key (App Store Connect > Users and Access > Integrations >
# App Store Connect API). Create a Team key with the Admin role, download the .p8
# file once, and keep it here with chmod 600.
FASTLANE_KEY_ID="XXXXXXXXXX"
FASTLANE_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
FASTLANE_KEY_PATH="~/.config/loop-build/AuthKey_XXXXXXXXXX.p8"

# Password that encrypts the local certificate repo. Pick a long random one and
# keep a copy in your password manager. If you import an existing Match-Secrets
# repo, use the MATCH_PASSWORD you set for it.
MATCH_PASSWORD="change-me"

# --- Optional ---------------------------------------------------------------

# Where the source comes from. Point this at a pull mirror on your own git
# server to fetch LoopWorkspace from there instead of GitHub.
#LOOP_REPO="https://github.com/LoopKit/LoopWorkspace.git"
#LOOP_BRANCH="main"

# Folder of patches to apply before each build. *.patch applies to LoopWorkspace,
# <Submodule>/*.patch inside that submodule. Default: ~/loop-build/patches.
# To use the patches kept in a clone of your loop-build repo:
#PATCH_DIR="~/loop-build-src/local-build/patches"

# Back up the encrypted certificate repo (~/loop-build/match-secrets.git) to a
# dedicated, empty, private repo on your own git server. loop-build runs
# "git push --mirror" to it after setup, after every successful certificate check,
# and after nuke-certs, so the backup becomes an exact copy (anything else in
# that repo is deleted). This is the only place loop-build ever pushes to.
# It runs unattended from launchd, so use credentials that need no prompt: an
# ssh deploy key without a passphrase (with write access), or an https token
# stored in git's credential helper. Avoid putting a token in the URL itself.
#MATCH_BACKUP_URL="ssh://git@forge.lan:2222/you/loop-match-secrets.git"
# Optional ssh key used only for that push (for example a deploy key that can
# write to the backup repo and nothing else):
#MATCH_BACKUP_SSH_KEY="~/.ssh/loop_match_backup"

# Xcode to build with. Empty = the version LoopKit's workflow uses, expected at
# /Applications/Xcode_<version>.app (e.g. /Applications/Xcode_27.1.app).
#XCODE_APP="/Applications/Xcode.app"

# 'auto' rebuilds when LoopKit or your patches change, and at least this often so
# the TestFlight build never reaches Apple's 90-day expiry.
#REBUILD_DAYS=30
#BUILD_ON_NEW_COMMITS=true

#KEEP_LOGS=30
#KEEP_ARTIFACTS=3

# Optional command run after each build. Gets LOOP_BUILD_STATUS (success, failure,
# or warning when the certificate backup failed), LOOP_BUILD_MESSAGE and
# LOOP_BUILD_LOG in its environment. Example using ntfy:
#NOTIFY_CMD='curl -s -d "$LOOP_BUILD_MESSAGE" https://ntfy.sh/your-private-topic'
